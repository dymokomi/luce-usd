## The schema names luce-usd reads and writes (UsdGeom's tokens and the
## prim type names), interned once per stage in its Names. The field is the
## name in snake case; the text is the USD token.
from sdf.names import Names

pub struct GeomTokens:
    pub var xform: u32
    pub var scope: u32
    pub var mesh: u32
    pub var basis_curves: u32
    pub var nurbs_curves: u32
    pub var points_type: u32
    pub var point_instancer: u32
    pub var geom_subset: u32
    pub var cube: u32
    pub var sphere: u32
    pub var cylinder: u32
    pub var cone: u32
    pub var capsule: u32
    pub var plane: u32
    pub var material: u32
    pub var points: u32
    pub var face_vertex_counts: u32
    pub var face_vertex_indices: u32
    pub var orientation: u32
    pub var normals: u32
    pub var extent: u32
    pub var double_sided: u32
    pub var subdivision_scheme: u32
    pub var interpolate_boundary: u32
    pub var face_varying_linear_interpolation: u32
    pub var triangle_subdivision_rule: u32
    pub var crease_indices: u32
    pub var crease_lengths: u32
    pub var crease_sharpnesses: u32
    pub var corner_indices: u32
    pub var corner_sharpnesses: u32
    pub var hole_indices: u32
    pub var xform_op_order: u32
    pub var visibility: u32
    pub var purpose: u32
    pub var curve_vertex_counts: u32
    pub var type_name: u32
    pub var basis: u32
    pub var wrap: u32
    pub var widths: u32
    pub var order: u32
    pub var knots: u32
    pub var point_weights: u32
    pub var ids: u32
    pub var proto_indices: u32
    pub var prototypes: u32
    pub var positions: u32
    pub var orientations: u32
    pub var orientationsf: u32
    pub var scales: u32
    pub var invisible_ids: u32
    pub var element_type: u32
    pub var family_name: u32
    pub var family_type: u32
    pub var indices: u32
    pub var size: u32
    pub var radius: u32
    pub var radius_top: u32
    pub var radius_bottom: u32
    pub var height: u32
    pub var axis: u32
    pub var width: u32
    pub var length: u32
    pub var interpolation: u32
    pub var element_size: u32
    pub var up_axis: u32
    pub var meters_per_unit: u32
    pub var material_binding: u32
    pub var left_handed: u32
    pub var right_handed: u32
    pub var catmull_clark: u32
    pub var loop_scheme: u32
    pub var bilinear: u32
    pub var none_value: u32
    pub var edge_only: u32
    pub var edge_and_corner: u32
    pub var all: u32
    pub var corners_only: u32
    pub var corners_plus1: u32
    pub var corners_plus2: u32
    pub var boundaries: u32
    pub var invisible: u32
    pub var inherited: u32
    pub var default_purpose: u32
    pub var render: u32
    pub var proxy: u32
    pub var guide: u32
    pub var linear: u32
    pub var cubic: u32
    pub var bezier: u32
    pub var bspline: u32
    pub var catmull_rom: u32
    pub var periodic: u32
    pub var pinned: u32
    pub var nonperiodic: u32
    pub var face: u32
    pub var point: u32
    pub var edge: u32
    pub var constant: u32
    pub var uniform: u32
    pub var varying: u32
    pub var vertex: u32
    pub var face_varying: u32
    pub var x_axis: u32
    pub var y_axis: u32
    pub var z_axis: u32
    pub var display_color: u32
    pub var display_opacity: u32
    pub var st: u32
    pub var reset_xform_stack: u32

    ## Every token, interned in `names`.
    pub func of(names: Names*) -> GeomTokens!:
        return GeomTokens(
            xform = try names.token("Xform"),
            scope = try names.token("Scope"),
            mesh = try names.token("Mesh"),
            basis_curves = try names.token("BasisCurves"),
            nurbs_curves = try names.token("NurbsCurves"),
            points_type = try names.token("Points"),
            point_instancer = try names.token("PointInstancer"),
            geom_subset = try names.token("GeomSubset"),
            cube = try names.token("Cube"),
            sphere = try names.token("Sphere"),
            cylinder = try names.token("Cylinder"),
            cone = try names.token("Cone"),
            capsule = try names.token("Capsule"),
            plane = try names.token("Plane"),
            material = try names.token("Material"),
            points = try names.token("points"),
            face_vertex_counts = try names.token("faceVertexCounts"),
            face_vertex_indices = try names.token("faceVertexIndices"),
            orientation = try names.token("orientation"),
            normals = try names.token("normals"),
            extent = try names.token("extent"),
            double_sided = try names.token("doubleSided"),
            subdivision_scheme = try names.token("subdivisionScheme"),
            interpolate_boundary = try names.token("interpolateBoundary"),
            face_varying_linear_interpolation = try names.token("faceVaryingLinearInterpolation"),
            triangle_subdivision_rule = try names.token("triangleSubdivisionRule"),
            crease_indices = try names.token("creaseIndices"),
            crease_lengths = try names.token("creaseLengths"),
            crease_sharpnesses = try names.token("creaseSharpnesses"),
            corner_indices = try names.token("cornerIndices"),
            corner_sharpnesses = try names.token("cornerSharpnesses"),
            hole_indices = try names.token("holeIndices"),
            xform_op_order = try names.token("xformOpOrder"),
            visibility = try names.token("visibility"),
            purpose = try names.token("purpose"),
            curve_vertex_counts = try names.token("curveVertexCounts"),
            type_name = try names.token("type"),
            basis = try names.token("basis"),
            wrap = try names.token("wrap"),
            widths = try names.token("widths"),
            order = try names.token("order"),
            knots = try names.token("knots"),
            point_weights = try names.token("pointWeights"),
            ids = try names.token("ids"),
            proto_indices = try names.token("protoIndices"),
            prototypes = try names.token("prototypes"),
            positions = try names.token("positions"),
            orientations = try names.token("orientations"),
            orientationsf = try names.token("orientationsf"),
            scales = try names.token("scales"),
            invisible_ids = try names.token("invisibleIds"),
            element_type = try names.token("elementType"),
            family_name = try names.token("familyName"),
            family_type = try names.token("familyType"),
            indices = try names.token("indices"),
            size = try names.token("size"),
            radius = try names.token("radius"),
            radius_top = try names.token("radiusTop"),
            radius_bottom = try names.token("radiusBottom"),
            height = try names.token("height"),
            axis = try names.token("axis"),
            width = try names.token("width"),
            length = try names.token("length"),
            interpolation = try names.token("interpolation"),
            element_size = try names.token("elementSize"),
            up_axis = try names.token("upAxis"),
            meters_per_unit = try names.token("metersPerUnit"),
            material_binding = try names.token("material:binding"),
            left_handed = try names.token("leftHanded"),
            right_handed = try names.token("rightHanded"),
            catmull_clark = try names.token("catmullClark"),
            loop_scheme = try names.token("loop"),
            bilinear = try names.token("bilinear"),
            none_value = try names.token("none"),
            edge_only = try names.token("edgeOnly"),
            edge_and_corner = try names.token("edgeAndCorner"),
            all = try names.token("all"),
            corners_only = try names.token("cornersOnly"),
            corners_plus1 = try names.token("cornersPlus1"),
            corners_plus2 = try names.token("cornersPlus2"),
            boundaries = try names.token("boundaries"),
            invisible = try names.token("invisible"),
            inherited = try names.token("inherited"),
            default_purpose = try names.token("default"),
            render = try names.token("render"),
            proxy = try names.token("proxy"),
            guide = try names.token("guide"),
            linear = try names.token("linear"),
            cubic = try names.token("cubic"),
            bezier = try names.token("bezier"),
            bspline = try names.token("bspline"),
            catmull_rom = try names.token("catmullRom"),
            periodic = try names.token("periodic"),
            pinned = try names.token("pinned"),
            nonperiodic = try names.token("nonperiodic"),
            face = try names.token("face"),
            point = try names.token("point"),
            edge = try names.token("edge"),
            constant = try names.token("constant"),
            uniform = try names.token("uniform"),
            varying = try names.token("varying"),
            vertex = try names.token("vertex"),
            face_varying = try names.token("faceVarying"),
            x_axis = try names.token("X"),
            y_axis = try names.token("Y"),
            z_axis = try names.token("Z"),
            display_color = try names.token("primvars:displayColor"),
            display_opacity = try names.token("primvars:displayOpacity"),
            st = try names.token("primvars:st"),
            reset_xform_stack = try names.token("!resetXformStack!"),
        )
