pub let same_value = values.same
pub let array_column = values.array_column
pub let apply_list_op = list_ops.apply_list_op

pub type SpecType = layer_data.SpecType
pub type LayerData = layer_data.LayerData
pub type FieldKeys = layer_data.FieldKeys

