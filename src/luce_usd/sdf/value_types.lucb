## The type named `text` ("point3f", "texCoord2f[]", ...): its entry and
## whether it is the array form; none for an unknown name.
pub func find_type(text: str) -> (TypeName, bool)?:
    var name = text
    var array = false
    if text.length > 2 and text.bytes[text.length - 2] == 91 and text.bytes[text.length - 1] == 93:
        name = (str)text.bytes[..<text.length - 2]
        array = true
    for entry in type_names:
        if entry.text == name:
            if array and entry.kind == ValueKind.empty: return none
            return (entry, array)
    for entry in extra_names:
        if entry.text == name: return (entry, array)
    return none

## Legacy names beyond the main table.
let extra_names: TypeName[4] = [
    TypeName("Matrix4d", ValueKind.matrix4d, Role.generic),
    TypeName("Frame", ValueKind.matrix4d, Role.frame),
    TypeName("Transform", ValueKind.matrix4d, Role.transform),
    TypeName("PointIndex", ValueKind.int, Role.point_index),
]
