## Number text for usda, self-contained: exact decimal parsing and shortest
## round-trip formatting. Destined for luce-base's std `strings` module,
## where the prism codec and other text formats can share it; until then it
## lives here whole, with nothing from the rest of luce-usd.
##
## Parsing (`parse_f64`): Clinger's fast path, then Eisel-Lemire (Lemire,
## "Number Parsing at a Gigabyte per Second", 2021, in the form of Go's
## strconv) over a 128-bit powers-of-ten table for 10^-348..10^347; the rare
## inputs neither decides go to strings.parse_f64 (the C library's strtod).
## Results are the correctly rounded binary64, as OpenUSD's TfStringToDouble
## gives.
##
## Formatting: the shortest digits that read back to the same value, and of
## those the closest (Ryu: Adams, "Ryu: Fast Float-to-String Conversion",
## PLDI 2018; the tables are Ryu's DOUBLE_POW5_SPLIT and _INV_SPLIT), laid out
## as OpenUSD's TfStringify does through double-conversion's ToShortest:
## "inf", "nan", no exponent sign for positive exponents, and decimal
## notation for decimal exponents -6..14 (`1e-7`, `0.000001`, `1e15`,
## `123456789012345`, `-0`). Floats use the float's own shortest digits
## (ToShortestSingle). Halves print as C's "%g" of their float value, as
## GfHalf's stream operator does.
##
## The tables are generated by a local script (gen_number_tables.py); do not
## edit them by hand.
import memory
import strings
from geocore_growing import Growing

## Every power of ten that f64 holds exactly.
let exact_powers: f64[23] = [1.0, 10.0, 100.0, 1000.0, 10000.0, 100000.0, 1000000.0, 10000000.0,
    100000000.0, 1000000000.0, 10000000000.0, 100000000000.0, 1000000000000.0, 10000000000000.0,
    100000000000000.0, 1000000000000000.0, 10000000000000000.0, 100000000000000000.0,
    1000000000000000000.0, 10000000000000000000.0, 100000000000000000000.0,
    1000000000000000000000.0, 10000000000000000000000.0]

## Mantissas up to 2^53 are exact in f64.
let exact_mantissa: u64 = 9007199254740992
## The decimal exponents lemire_powers covers.
let smallest_exponent: i64 = -348
let largest_exponent: i64 = 347

# --- Parsing ---------------------------------------------------------------

## The number `text` spells: [-+]digits[.digits][(e|E)[-+]digits],
## .digits[...], "inf", "-inf" or "nan". Fails when `text` is not one.
pub func parse_f64(text: const u8[]) -> f64!:
    if let value = decimal(text): return value
    return try strings.parse_f64((str)text)

## 10^power for 0 <= power <= 22, exactly.
pub func exact_power(power: i64) -> f64:
    return exact_powers[(usize)power]

## Clinger's fast path, then Eisel-Lemire; none when the text is not a plain
## decimal or neither decides.
func decimal(bytes: const u8[]) -> f64?:
    var at: usize = 0
    let end = bytes.length
    let negative = at < end and bytes[at] == '-'
    if at < end and (bytes[at] == '-' or bytes[at] == '+'): at += 1
    var mantissa: u64 = 0
    var digits: usize = 0
    var scale: i64 = 0
    var seen = false
    while at < end and bytes[at] >= '0' and bytes[at] <= '9':
        let digit = (u64)(bytes[at] - '0')
        seen = true
        if mantissa != 0 or digit != 0:
            if digits == 19: return none
            mantissa = mantissa * 10 + digit
            digits += 1
        at += 1
    if at < end and bytes[at] == '.':
        at += 1
        while at < end and bytes[at] >= '0' and bytes[at] <= '9':
            let digit = (u64)(bytes[at] - '0')
            seen = true
            scale -= 1
            if mantissa != 0 or digit != 0:
                if digits == 19: return none
                mantissa = mantissa * 10 + digit
                digits += 1
            at += 1
    if not seen: return none
    if at < end and (bytes[at] == 'e' or bytes[at] == 'E'):
        at += 1
        let down = at < end and bytes[at] == '-'
        if at < end and (bytes[at] == '-' or bytes[at] == '+'): at += 1
        var exponent: i64 = 0
        var count: usize = 0
        while at < end and bytes[at] >= '0' and bytes[at] <= '9':
            if count == 6: return none
            exponent = exponent * 10 + (i64)(bytes[at] - '0')
            count += 1
            at += 1
        if count == 0: return none
        scale += -exponent if down else exponent
    if at != end: return none
    var value: f64 = 0.0
    if mantissa != 0:
        if mantissa > exact_mantissa or scale < -22 or scale > 22:
            return lemire(mantissa, scale, negative)
        value = (f64)mantissa
        value = value * exact_powers[(usize)scale] if scale >= 0 else value / exact_powers[(usize)(-scale)]
    return -value if negative else value

## `mantissa * 10^exponent`, correctly rounded, or none when undecided.
func lemire(mantissa: u64, exponent: i64, negative: bool) -> f64?:
    if exponent < smallest_exponent or exponent > largest_exponent: return none
    let zeros = leading_zeros(mantissa)
    let man = mantissa << zeros
    var binary = (u64)(((217706 * exponent) >> 16) + 64 + 1023 - (i64)zeros)
    let row = (usize)(exponent - smallest_exponent) * 2
    var low: u64 = 0
    var high = product(man, lemire_powers[row], &low)
    # The top 55 bits may be off by the truncated low word: widen when unsure.
    if high & 0x1FF == 0x1FF and low +% man < man:
        var extra_low: u64 = 0
        let extra_high = product(man, lemire_powers[row + 1], &extra_low)
        var merged_high = high
        let merged_low = low +% extra_high
        if merged_low < low: merged_high = merged_high +% 1
        if merged_high & 0x1FF == 0x1FF and merged_low +% 1 == 0 and extra_low +% man < man: return none
        high = merged_high
        low = merged_low
    let top = high >> 63
    var result = high >> (top + 9)
    binary = binary -% (1 ^ top)
    # An exact halfway case needs the full decimal to break the tie.
    if low == 0 and high & 0x1FF == 0 and result & 3 == 1: return none
    result = (result + (result & 1)) >> 1
    if (result >> 53) > 0:
        result >>= 1
        binary = binary +% 1
    # Zero or wrapped: subnormal; 0x7FF or more: infinite.
    if binary -% 1 >= 0x7FF - 1: return none
    var bits = (binary << 52) | (result & 0xFFFFFFFFFFFFF)
    if negative: bits |= 0x8000000000000000
    return f64.bits(bits)

## The 128-bit product a * b: the high word, the low word stored in `low`.
inline func product(a: u64, b: u64, low: u64*) -> u64:
    let a0 = a & 0xFFFFFFFF
    let a1 = a >> 32
    let b0 = b & 0xFFFFFFFF
    let b1 = b >> 32
    let p00 = a0 * b0
    let p01 = a0 * b1
    let p10 = a1 * b0
    let p11 = a1 * b1
    let middle = (p00 >> 32) + (p01 & 0xFFFFFFFF) + (p10 & 0xFFFFFFFF)
    *low = (middle << 32) | (p00 & 0xFFFFFFFF)
    return p11 + (p01 >> 32) + (p10 >> 32) + (middle >> 32)

## Leading zero bits of a nonzero value.
inline func leading_zeros(value: u64) -> u64:
    var v = value
    var count: u64 = 0
    if v & 0xFFFFFFFF00000000 == 0:
        count += 32
        v <<= 32
    if v & 0xFFFF000000000000 == 0:
        count += 16
        v <<= 16
    if v & 0xFF00000000000000 == 0:
        count += 8
        v <<= 8
    if v & 0xF000000000000000 == 0:
        count += 4
        v <<= 4
    if v & 0xC000000000000000 == 0:
        count += 2
        v <<= 2
    if v & 0x8000000000000000 == 0: count += 1
    return count

# --- Formatting ------------------------------------------------------------

## Append TfStringify(double) of `value`.
pub func write_double(out: Growing[u8]*, value: f64) -> !:
    var text: u8[32] = ---
    let length = format_double(value, text)
    try append(out, text[..<length])

## Append TfStringify(float) of `value`: the float's own shortest digits.
pub func write_float(out: Growing[u8]*, value: f32) -> !:
    var text: u8[32] = ---
    let length = format_float(value, text)
    try append(out, text[..<length])

func append(out: Growing[u8]*, bytes: const u8[]) -> !:
    try out.reserve(out.count + bytes.length)
    memory.copy(out.items[out.count..], bytes, bytes.length)
    out.count += bytes.length

## TfStringify(double) of `value` into `text` (32 bytes suffice); its length.
pub func format_double(value: f64, text: u8[]) -> usize:
    let bits = value.bits()
    let negative = (bits >> 63) != 0
    let exponent_bits = (u32)((bits >> 52) & 0x7FF)
    let mantissa_bits = bits & 0xFFFFFFFFFFFFF
    if exponent_bits == 0x7FF: return special(text, negative, mantissa_bits != 0)
    if exponent_bits == 0 and mantissa_bits == 0: return zero(text, negative)
    let (digits, exponent) = shortest64(mantissa_bits, exponent_bits)
    return layout(text, negative, digits, exponent)

## TfStringify(float) of `value` into `text` (32 bytes suffice); its length.
pub func format_float(value: f32, text: u8[]) -> usize:
    let bits = value.bits()
    let negative = (bits >> 31) != 0
    let exponent_bits = (bits >> 23) & 0xFF
    let mantissa_bits = bits & 0x7FFFFF
    if exponent_bits == 0xFF: return special(text, negative, mantissa_bits != 0)
    if exponent_bits == 0 and mantissa_bits == 0: return zero(text, negative)
    let (digits, exponent) = shortest32(mantissa_bits, exponent_bits)
    return layout(text, negative, (u64)digits, exponent)

func special(text: u8[], negative: bool, nan: bool) -> usize:
    if nan: return copy_text(text, "nan")
    if negative: return copy_text(text, "-inf")
    return copy_text(text, "inf")

func zero(text: u8[], negative: bool) -> usize:
    return copy_text(text, "-0" if negative else "0")

func copy_text(text: u8[], literal: str) -> usize:
    memory.copy(text, literal.bytes, literal.length)
    return literal.length

## double-conversion's ToShortest layout of digits * 10^exponent into text.
func layout(text: u8[], negative: bool, digits: u64, exponent: i32) -> usize:
    var reversed: u8[20] = ---
    var count: usize = 0
    var rest = digits
    while rest > 0:
        reversed[count] = (u8)(48 + rest % 10)
        count += 1
        rest = rest // 10
    let point = (i64)exponent + (i64)count
    let decimal_exponent = point - 1
    var at: usize = 0
    if negative:
        text[0] = '-'
        at = 1
    if decimal_exponent >= -6 and decimal_exponent < 15:
        if point <= 0:
            text[at] = '0'
            text[at + 1] = '.'
            at += 2
            for _ in 0..<(usize)(-point):
                text[at] = '0'
                at += 1
            for index in 0..<count:
                text[at] = reversed[count - 1 - index]
                at += 1
        elif (usize)point >= count:
            for index in 0..<count:
                text[at] = reversed[count - 1 - index]
                at += 1
            for _ in 0..<((usize)point - count):
                text[at] = '0'
                at += 1
        else:
            for index in 0..<(usize)point:
                text[at] = reversed[count - 1 - index]
                at += 1
            text[at] = '.'
            at += 1
            for index in (usize)point..<count:
                text[at] = reversed[count - 1 - index]
                at += 1
        return at
    text[at] = reversed[count - 1]
    at += 1
    if count > 1:
        text[at] = '.'
        at += 1
        for index in 1..<count:
            text[at] = reversed[count - 1 - index]
            at += 1
    text[at] = 'e'
    at += 1
    var power = decimal_exponent
    if power < 0:
        text[at] = '-'
        at += 1
        power = -power
    var power_digits: u8[8] = ---
    var width: usize = 0
    while true:
        power_digits[width] = (u8)(48 + power % 10)
        width += 1
        power = power // 10
        if power == 0: break
    while width > 0:
        width -= 1
        text[at] = power_digits[width]
        at += 1
    return at

## Ryu's d2d: the shortest decimal digits * 10^exponent of a finite, nonzero
## binary64 given its mantissa and exponent fields.
func shortest64(ieee_mantissa: u64, ieee_exponent: u32) -> (u64, i32):
    var e2: i32 = 0
    var m2: u64 = 0
    if ieee_exponent == 0:
        e2 = 1 - 1023 - 52 - 2
        m2 = ieee_mantissa
    else:
        e2 = (i32)ieee_exponent - 1023 - 52 - 2
        m2 = ((u64)1 << 52) | ieee_mantissa
    let accept_bounds = (m2 & 1) == 0
    let mv = 4 * m2
    let mm_shift: u64 = 1 if ieee_mantissa != 0 or ieee_exponent <= 1 else 0
    var vr: u64 = 0
    var vp: u64 = 0
    var vm: u64 = 0
    var e10: i32 = 0
    var vm_trailing_zeros = false
    var vr_trailing_zeros = false
    if e2 >= 0:
        let q = log10_pow2(e2) - (1 if e2 > 3 else 0)
        e10 = q
        let k = 125 + pow5_bits(q) - 1
        let i = -e2 + q + k
        let row = (usize)q * 2
        vr = mul_shift64(4 * m2, pow5_inv_split[row], pow5_inv_split[row + 1], i)
        vp = mul_shift64(4 * m2 + 2, pow5_inv_split[row], pow5_inv_split[row + 1], i)
        vm = mul_shift64(4 * m2 - 1 - mm_shift, pow5_inv_split[row], pow5_inv_split[row + 1], i)
        if q <= 21:
            if mv % 5 == 0: vr_trailing_zeros = pow5_factor(mv) >= (u32)q
            elif accept_bounds: vm_trailing_zeros = pow5_factor(mv - 1 - mm_shift) >= (u32)q
            elif pow5_factor(mv + 2) >= (u32)q: vp -= 1
    else:
        let q = log10_pow5(-e2) - (1 if -e2 > 1 else 0)
        e10 = q + e2
        let i = -e2 - q
        let k = pow5_bits(i) - 125
        let j = q - k
        let row = (usize)i * 2
        vr = mul_shift64(4 * m2, pow5_split[row], pow5_split[row + 1], j)
        vp = mul_shift64(4 * m2 + 2, pow5_split[row], pow5_split[row + 1], j)
        vm = mul_shift64(4 * m2 - 1 - mm_shift, pow5_split[row], pow5_split[row + 1], j)
        if q <= 1:
            vr_trailing_zeros = true
            if accept_bounds: vm_trailing_zeros = mm_shift == 1
            else: vp -= 1
        elif q < 63:
            vr_trailing_zeros = (mv & (((u64)1 << (u64)q) - 1)) == 0
    var removed: i32 = 0
    var last_removed: u64 = 0
    var output: u64 = 0
    if vm_trailing_zeros or vr_trailing_zeros:
        while vp // 10 > vm // 10:
            vm_trailing_zeros = vm_trailing_zeros and vm % 10 == 0
            vr_trailing_zeros = vr_trailing_zeros and last_removed == 0
            last_removed = vr % 10
            vr = vr // 10
            vp = vp // 10
            vm = vm // 10
            removed += 1
        if vm_trailing_zeros:
            while vm % 10 == 0:
                vr_trailing_zeros = vr_trailing_zeros and last_removed == 0
                last_removed = vr % 10
                vr = vr // 10
                vp = vp // 10
                vm = vm // 10
                removed += 1
        if vr_trailing_zeros and last_removed == 5 and vr % 2 == 0: last_removed = 4
        let up = (vr == vm and (not accept_bounds or not vm_trailing_zeros)) or last_removed >= 5
        output = vr + (1 if up else 0)
    else:
        var round_up = false
        if vp // 100 > vm // 100:
            round_up = vr % 100 >= 50
            vr = vr // 100
            vp = vp // 100
            vm = vm // 100
            removed += 2
        while vp // 10 > vm // 10:
            round_up = vr % 10 >= 5
            vr = vr // 10
            vp = vp // 10
            vm = vm // 10
            removed += 1
        output = vr + (1 if vr == vm or round_up else 0)
    return (output, e10 + removed)

## Ryu's f2d, over the same tables: the shortest decimal digits * 10^exponent
## of a finite, nonzero binary32.
func shortest32(ieee_mantissa: u32, ieee_exponent: u32) -> (u32, i32):
    var e2: i32 = 0
    var m2: u32 = 0
    if ieee_exponent == 0:
        e2 = 1 - 127 - 23 - 2
        m2 = ieee_mantissa
    else:
        e2 = (i32)ieee_exponent - 127 - 23 - 2
        m2 = ((u32)1 << 23) | ieee_mantissa
    let accept_bounds = (m2 & 1) == 0
    let mv = 4 * m2
    let mp = 4 * m2 + 2
    let mm_shift: u32 = 1 if ieee_mantissa != 0 or ieee_exponent <= 1 else 0
    let mm = 4 * m2 - 1 - mm_shift
    var vr: u32 = 0
    var vp: u32 = 0
    var vm: u32 = 0
    var e10: i32 = 0
    var vm_trailing_zeros = false
    var vr_trailing_zeros = false
    var last_removed: u32 = 0
    if e2 >= 0:
        let q = log10_pow2(e2)
        e10 = q
        let k = 61 + pow5_bits(q) - 1
        let i = -e2 + q + k
        vr = pow5_inv_div_pow2(mv, q, i)
        vp = pow5_inv_div_pow2(mp, q, i)
        vm = pow5_inv_div_pow2(mm, q, i)
        if q != 0 and (vp - 1) // 10 <= vm // 10:
            let l = 61 + pow5_bits(q - 1) - 1
            last_removed = pow5_inv_div_pow2(mv, q - 1, -e2 + q - 1 + l) % 10
        if q <= 9:
            if mv % 5 == 0: vr_trailing_zeros = pow5_factor((u64)mv) >= (u32)q
            elif accept_bounds: vm_trailing_zeros = pow5_factor((u64)mm) >= (u32)q
            elif pow5_factor((u64)mp) >= (u32)q: vp -= 1
    else:
        let q = log10_pow5(-e2)
        e10 = q + e2
        let i = -e2 - q
        let k = pow5_bits(i) - 61
        var j = q - k
        vr = pow5_div_pow2(mv, i, j)
        vp = pow5_div_pow2(mp, i, j)
        vm = pow5_div_pow2(mm, i, j)
        if q != 0 and (vp - 1) // 10 <= vm // 10:
            j = q - 1 - (pow5_bits(i + 1) - 61)
            last_removed = pow5_div_pow2(mv, i + 1, j) % 10
        if q <= 1:
            vr_trailing_zeros = true
            if accept_bounds: vm_trailing_zeros = mm_shift == 1
            else: vp -= 1
        elif q < 31:
            vr_trailing_zeros = (mv & (((u32)1 << (u32)(q - 1)) - 1)) == 0
    var removed: i32 = 0
    var output: u32 = 0
    if vm_trailing_zeros or vr_trailing_zeros:
        while vp // 10 > vm // 10:
            vm_trailing_zeros = vm_trailing_zeros and vm % 10 == 0
            vr_trailing_zeros = vr_trailing_zeros and last_removed == 0
            last_removed = vr % 10
            vr = vr // 10
            vp = vp // 10
            vm = vm // 10
            removed += 1
        if vm_trailing_zeros:
            while vm % 10 == 0:
                vr_trailing_zeros = vr_trailing_zeros and last_removed == 0
                last_removed = vr % 10
                vr = vr // 10
                vp = vp // 10
                vm = vm // 10
                removed += 1
        if vr_trailing_zeros and last_removed == 5 and vr % 2 == 0: last_removed = 4
        let up = (vr == vm and (not accept_bounds or not vm_trailing_zeros)) or last_removed >= 5
        output = vr + (1 if up else 0)
    else:
        while vp // 10 > vm // 10:
            last_removed = vr % 10
            vr = vr // 10
            vp = vp // 10
            vm = vm // 10
            removed += 1
        output = vr + (1 if vr == vm or last_removed >= 5 else 0)
    return (output, e10 + removed)

## floor(log2(5^e)) + 1 for 0 <= e <= 3528.
inline func pow5_bits(e: i32) -> i32:
    return (i32)((((u32)e) * 1217359) >> 19) + 1

## floor(log10(2^e)) for 0 <= e <= 1650.
inline func log10_pow2(e: i32) -> i32:
    return (i32)((((u32)e) * 78913) >> 18)

## floor(log10(5^e)) for 0 <= e <= 2620.
inline func log10_pow5(e: i32) -> i32:
    return (i32)((((u32)e) * 732923) >> 20)

## How many times 5 divides `value` (nonzero).
func pow5_factor(value: u64) -> u32:
    var rest = value
    var count: u32 = 0
    while rest % 5 == 0:
        rest = rest // 5
        count += 1
    return count

## ((m * (high:low)) >> j) for Ryu's 125-bit multipliers.
inline func mul_shift64(m: u64, low: u64, high: u64, j: i32) -> u64:
    var b0_low: u64 = 0
    let b0_high = product(m, low, &b0_low)
    var b2_low: u64 = 0
    var b2_high = product(m, high, &b2_low)
    let sum_low = b2_low +% b0_high
    if sum_low < b2_low: b2_high += 1
    let shift = (u64)(j - 64)
    if shift == 0: return sum_low
    if shift >= 64: return b2_high >> (shift - 64)
    return (b2_high << (64 - shift)) | (sum_low >> shift)

inline func mul_shift32(m: u32, factor: u64, shift: i32) -> u32:
    let low = (u64)m * (factor & 0xFFFFFFFF)
    let high = (u64)m * (factor >> 32)
    let sum = (low >> 32) + high
    return (u32)(sum >> (u64)(shift - 32))

inline func pow5_inv_div_pow2(m: u32, q: i32, j: i32) -> u32:
    return mul_shift32(m, pow5_inv_split[(usize)q * 2 + 1] + 1, j)

inline func pow5_div_pow2(m: u32, i: i32, j: i32) -> u32:
    return mul_shift32(m, pow5_split[(usize)i * 2 + 1], j)

## Append C's "%g" of a half's value (six significant digits, trailing zeros
## dropped, exponent form below 1e-4 and from 1e6), as GfHalf streams. The
## digits come from the half's exact decimal expansion, rounded half to even.
pub func write_half(out: Growing[u8]*, bits: u16) -> !:
    let negative = (bits >> 15) != 0
    let exponent_bits = (u32)((bits >> 10) & 0x1F)
    let fraction = (u64)(bits & 0x3FF)
    if exponent_bits == 0x1F:
        var text: u8[8] = ---
        let length = special(text, negative, fraction != 0)
        try append(out, text[..<length])
        return
    if negative: try out.push('-')
    if exponent_bits == 0 and fraction == 0:
        try out.push('0')
        return
    # value = significand * 2^power exactly.
    let significand = fraction if exponent_bits == 0 else fraction | 0x400
    let power: i64 = -24 if exponent_bits == 0 else (i64)exponent_bits - 25
    # Exact decimal: significand * 5^-power * 10^power for negative powers,
    # in four 32-bit limbs (significand < 2^11 and 5^24 < 2^56).
    var limbs: u32[4]
    limbs[0] = (u32)significand
    var scale: i64 = 0
    if power >= 0:
        limbs[0] = (u32)(significand << (u64)power)
    else:
        for _ in 0..<(usize)(-power):
            var carry: u64 = 0
            for index: usize in 0..<4:
                let next = (u64)limbs[index] * 5 + carry
                limbs[index] = (u32)(next & 0xFFFFFFFF)
                carry = next >> 32
        scale = power
    var digits: u8[24]
    var count: usize = 0
    while limbs[0] != 0 or limbs[1] != 0 or limbs[2] != 0 or limbs[3] != 0:
        var remainder: u64 = 0
        var index: usize = 4
        while index > 0:
            index -= 1
            let current = (remainder << 32) | (u64)limbs[index]
            limbs[index] = (u32)(current // 10)
            remainder = current % 10
        digits[count] = (u8)remainder
        count += 1
    # digits are least significant first; round to six significant digits.
    var kept = count
    var exponent10 = (i64)count - 1 + scale
    if count > 6:
        let drop = count - 6
        # Half to even over the dropped digits.
        let first = digits[drop - 1]
        var tail_zero = true
        for index in 0..<drop - 1:
            if digits[index] != 0: tail_zero = false
        var up = first > 5 or (first == 5 and not tail_zero) or (first == 5 and tail_zero and digits[drop] % 2 == 1)
        var index = drop
        while up and index < count:
            if digits[index] == 9:
                digits[index] = 0
                index += 1
            else:
                digits[index] += 1
                up = false
        # Keep the six most significant digits.
        for at: usize in 0..<6: digits[at] = digits[drop + at]
        kept = 6
        if up:
            digits[5] = 1
            exponent10 += 1
    # Most significant first, trailing zeros removed.
    var first_kept: usize = 0
    while first_kept + 1 < kept and digits[first_kept] == 0: first_kept += 1
    if exponent10 < -4 or exponent10 >= 6:
        try out.push('0' + digits[kept - 1])
        if kept - 1 > first_kept:
            try out.push('.')
            var at = kept - 1
            while at > first_kept:
                at -= 1
                try out.push('0' + digits[at])
        try out.push('e')
        var magnitude = exponent10
        if magnitude < 0:
            try out.push('-')
            magnitude = -magnitude
        else:
            try out.push('+')
        if magnitude < 10: try out.push('0')
        var reversed: u8[4]
        var width: usize = 0
        while true:
            reversed[width] = (u8)(48 + magnitude % 10)
            width += 1
            magnitude = magnitude // 10
            if magnitude == 0: break
        while width > 0:
            width -= 1
            try out.push(reversed[width])
        return
    # Fixed notation: digit at position p has weight 10^(exponent10 - (kept - 1 - p)).
    if exponent10 < 0:
        try out.push('0')
        try out.push('.')
        for _ in 0..<(usize)(-exponent10 - 1): try out.push('0')
        var at = kept
        while at > first_kept:
            at -= 1
            try out.push('0' + digits[at])
        return
    let integer_digits = (usize)exponent10 + 1
    var at = kept
    var written: usize = 0
    while written < integer_digits:
        if at > 0:
            at -= 1
            try out.push('0' + digits[at])
        else:
            try out.push('0')
        written += 1
    if at > first_kept:
        try out.push('.')
        while at > first_kept:
            at -= 1
            try out.push('0' + digits[at])

