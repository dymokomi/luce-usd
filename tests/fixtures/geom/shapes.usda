#usda 1.0

def Cube "Box"
{
    double size = 4
    color3f[] primvars:displayColor = [(0, 0, 1)]
}

def Sphere "Ball"
{
    double radius = 2
    double3 xformOp:translate = (10, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Cylinder "Can"
{
    uniform token axis = "X"
}

def Cone "Hat"
{
}

def Capsule "Pill"
{
    uniform token axis = "Y"
}

def Plane "Floor"
{
    double width = 10
}
