#usda 1.0
(
    doc = "Built-in properties flatten with their schema's type and variability."
)

def Xform "Root" (
    apiSchemas = ["MaterialBindingAPI", "CollectionAPI:lights"]
)
{
    rel collection:lights:includes = </Root/Tri>
    custom rel material:binding = </Root/Look>
    token visibility = "inherited"
    double3 xformOp:translate = (1, 2, 3)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Mesh "Tri"
    {
        uniform bool doubleSided = 1
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        token interpolateBoundary = "edgeOnly"
        float3[] myPoints = [(0, 0, 0)]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    }

    def Material "Look"
    {
    }
}

