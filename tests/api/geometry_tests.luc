## Usd.load, save, convert, info and warnings as luced-3d calls them.
from usd import Usd
from geocore import invalid, Mesh

pub func geometry_tests() -> unit!:
    let loaded = Usd.load("tests/fixtures/geom/meshes.usda")
    let mesh = loaded.mesh() else error(invalid, "no mesh")
    assert(mesh.face_count() == 3)
    assert(Usd.warnings().contains("faces with fewer than 3 corners"))
    assert(loaded.detail_value("usd.time") == 1.0)
    let later = Usd.load("tests/fixtures/geom/meshes.usda", time = 2.0)
    assert((later.mesh() else error(invalid, "no mesh")).point(6).x == 2.0)
    for name in ["saved.usda", "saved.usdc", "saved.usdz"]:
        Usd.save(loaded, name)
        let again = Usd.load(name)
        assert((again.mesh() else error(invalid, "no mesh")).face_count() == 3)
    assert(Usd.serialization("saved.usdz") == "usdz")
    Usd.convert("saved.usdc", "converted.usda")
    assert(Usd.serialization("converted.usda") == "usda")
    let info = Usd.info("tests/fixtures/geom/meshes.usda")
    assert(info.contains("upAxis: Z") and info.contains("type Mesh: 2") and info.contains("prims: "))
    let flat = Usd.load("tests/fixtures/geom/instancer.usda", flatten = true)
    assert((flat.mesh() else error(invalid, "no mesh")).face_count() == 7)
    let placed = Usd.load("tests/fixtures/geom/instancer.usda")
    assert(placed.instance_count() == 3)
    # A spline-animated size: 2 halfway, 3 once held after its last knot.
    let halfway = Usd.load("tests/fixtures/geom/spline_size.usda", time = 5.0, subdivide = false)
    assert(largest_x(halfway.mesh() else error(invalid, "no mesh")) == 1.0)
    let held = Usd.load("tests/fixtures/geom/spline_size.usda", time = 20.0, subdivide = false)
    assert(largest_x(held.mesh() else error(invalid, "no mesh")) == 1.5)

## A composed stage: the museum's time-offset case loads through its
## references and sublayers, and flattens to a file.
pub func composed_tests() -> unit!:
    let loaded = Usd.load("tests/fixtures/openusd/museum/BasicAncestralReference/root.usda")
    assert(loaded.is_empty())
    Usd.flatten("tests/fixtures/openusd/museum/BasicTimeOffset/root.usda", "flat.usda")
    assert(Usd.info("flat.usda").contains("prims: "))
    stage_option_tests()

## Variant selections and payload masks, and the composition summary the
## File node shows: the room's table top is a quad or two triangles, its
## lamp a payload of three triangles, its two chairs instances.
func stage_option_tests() -> unit!:
    let room = "tests/fixtures/geom/room.usda"
    let loaded = Usd.load(room)
    assert((loaded.mesh() else error(invalid, "no mesh")).face_count() == 4)
    assert(loaded.instance_count() == 2)
    let chosen = Usd.load(room, variants = "/Room/Table{ top = triangles }")
    assert((chosen.mesh() else error(invalid, "no mesh")).face_count() == 5)
    let bare = Usd.load(room, payloads = "-")
    assert((bare.mesh() else error(invalid, "no mesh")).face_count() == 1)
    let lamp = Usd.load(room, payloads = "/Room/Lamp*")
    assert((lamp.mesh() else error(invalid, "no mesh")).face_count() == 4)
    assert(Usd.composition(room) == "2\t7\t2\n/Room/Table\ttop\tquad\tquad|triangles\n")
    let composed = Usd.composition(room, variants = "/Room/Table{top=triangles}", payloads = "-")
    assert(composed == "1\t5\t2\n/Room/Table\ttop\ttriangles\tquad|triangles\n")

func largest_x(mesh: Mesh) -> float!:
    var most = -1000000.0
    for at in 0..<mesh.point_count():
        let x = mesh.point(at).x
        if x > most:
            most = x
    return most
